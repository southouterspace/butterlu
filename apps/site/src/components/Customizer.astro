---
// The editor on the Personalize screen: live preview plus the options the print
// file is made from. Defaults first: the frame arrives fully designed and can go in the
// cart untouched. Words are the common change, so they sit open, with wording ideas
// drawn as small frames and a note on any side that still holds an example name;
// shape is a two-way toggle; backgrounds open in a bottom sheet on phones (inline
// from md up); fonts and text color wait behind one disclosure. Background size and
// position are the store's, set per design in admin: the shopper sees them, never sets them. Server-rendered with
// the preset selected, so the page reads and works before the script runs.
import { BACKGROUNDS, FONTS, SHAPES, SIDES } from '@butterlu/frame';
import { MAX_SIDE_CHARS, SIDE_LABEL, TEXT_COLORS, parseDesign } from '@butterlu/frame/design';
import { type Product, SHOP, formatPrice } from '../catalog/products';
import { type Idea, productIdeas } from '../catalog/copy';
import { standInNote } from '../catalog/example-names';
import { groupedBackgrounds } from '../lib/background-groups';
import { frameSvg } from '../lib/frame-svg';
import { placementsAtBuild } from '../lib/layout-build';
import Icon from './ui/Icon.astro';
import { buttonVariants, cn, inputClass, nativeSelectClass } from './ui/variants';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const preset = product.preset;
const svg = frameSvg(preset, placementsAtBuild(preset), { idPrefix: 'pdp', label: `${product.name} preview` });
const presetColor = Object.values(preset.sides).find((s) => s?.color)?.color ?? 'auto';
const presetBackground = BACKGROUNDS.find((b) => b.id === preset.backgroundId)!;
const shapeName = { 'rounded-rectangle': 'Rounded', scalloped: 'Scalloped' } as const;
// Only the sides need a hint: their text runs up or down.
const sideHelp: Partial<Record<(typeof SIDES)[number], string>> = { left: 'Reads upward', right: 'Reads downward' };
const fontName = (id: string) => FONTS.find((f) => f.id === id)?.name.replace(/ (Bold|SemiBold)$/, '') ?? id;
const usedFonts = [...new Set(SIDES.flatMap((s) => (preset.sides[s] ? [fontName(preset.sides[s]!.fontId)] : [])))];
const colorName = presetColor === 'auto' ? 'Best for the Background' : (TEXT_COLORS.find((c) => c.hex === presetColor)?.name ?? presetColor);
const groups = groupedBackgrounds();
const pickerId = `bg-picker-${product.handle}`;
const config = { handle: product.handle, preset };
const price = formatPrice(product.priceCents);
// Wording ideas load into the text fields with one tap; the frame stays the same product.
const ideas: Idea[] = productIdeas(product.handle);
const ideaLabel = (i: Idea) => SIDES.flatMap((s) => (i[s] ? [i[s]] : [])).join(' · ');
// Each idea drawn as a small frame in the preset's shape, background and fonts, the way
// the script would set it, so the shopper sees where the words go before trying one.
const ideaSvg = (idea: Idea, i: number) => {
  const sides = Object.fromEntries(
    SIDES.flatMap((side) => {
      const text = idea[side];
      if (!text) return [];
      const p = preset.sides[side];
      return [[side, { text, fontId: p?.fontId ?? 'playfair-display-bold', ...(p?.rotation !== undefined ? { rotation: p.rotation } : {}), ...(presetColor !== 'auto' ? { color: presetColor } : {}) }]];
    }),
  );
  const r = parseDesign({ shape: preset.shape, backgroundId: preset.backgroundId, backgroundFit: preset.backgroundFit, sides });
  return r.ok ? frameSvg(r.spec, placementsAtBuild(r.spec), { idPrefix: `idea-${i}`, photoHint: false, size: 'card', lazy: true }) : '';
};
const exampleNote = (side: (typeof SIDES)[number]) => standInNote(preset.sides[side]?.text ?? '');
const legend = 'mb-2 flex items-baseline gap-2 text-sm font-medium';
---
<div class="customizer grid gap-4 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] md:items-start md:gap-10" data-customizer={JSON.stringify(config)}>
  <!-- Sticky on phones too, so every change shows while the shopper is choosing. -->
  <div class="preview-dock sticky top-0 z-20 -mx-4 min-w-0 bg-background px-4 pt-2 pb-3 md:top-6 md:mx-0 md:bg-transparent md:p-0">
    <div class="preview rounded-4xl bg-muted p-3 md:p-8" data-preview set:html={svg} />
  </div>

  <form class="flex min-w-0 flex-col gap-6" data-form novalidate autocomplete="off">
    <div>
      <h1 class="text-2xl md:text-3xl">{product.name}</h1>
      <p class="mt-1 text-lg font-semibold">{price}</p>
    </div>

    <fieldset class="min-w-0">
      <legend class={legend}>Your Words</legend>
      {/* Hidden until the script mounts it: the buttons only work with it. */}
      {ideas.length > 0 && (
        <div class="mb-4" data-ideas hidden>
          <p class="mb-2 text-sm font-medium" id="ideas-label">Wording Ideas</p>
          <ul class="-mx-4 flex snap-x scroll-px-4 gap-2 overflow-x-auto overscroll-x-contain px-4 pb-2 md:mx-0 md:scroll-px-0 md:px-0" aria-labelledby="ideas-label">
            {ideas.map((idea, i) => {
              const art = ideaSvg(idea, i);
              return (
                <li class="shrink-0 snap-start">
                  {art ? (
                    <button type="button" class="idea block w-28 rounded-2xl bg-muted p-1.5 ring-1 ring-foreground/10 transition-shadow outline-none hover:ring-foreground/30 focus-visible:ring-3 focus-visible:ring-ring sm:w-32" aria-label={ideaLabel(idea)} data-idea={JSON.stringify(idea)} set:html={art} />
                  ) : (
                    <button type="button" class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'h-auto min-h-9 max-w-56 py-1.5 text-left whitespace-normal')} data-idea={JSON.stringify(idea)}>{ideaLabel(idea)}</button>
                  )}
                </li>
              );
            })}
          </ul>
          <button type="button" class={cn(buttonVariants({ variant: 'link', size: 'sm' }), 'mt-1 px-0')} data-idea-undo hidden>Undo, Bring My Words Back</button>
        </div>
      )}
      {/* Sides with no words start folded to one tap each, so the form shows only what the
          design uses. The script opens a side when it gets words (an idea, a saved draft).
          Without script nothing can be added to the cart, so nothing is lost by the fold. */}
      <div class="grid gap-3">
        {SIDES.map((side) => (
          <div class="grid gap-1.5" data-side-row={side} hidden={!preset.sides[side]?.text}>
            <div class="flex items-baseline gap-1.5">
              <label for={`text-${side}`} class="text-sm font-medium">{SIDE_LABEL[side]}</label>
              {sideHelp[side] && <span class="text-sm text-muted-foreground"><span aria-hidden="true">· </span><span id={`help-${side}`}>{sideHelp[side]}</span></span>}
            </div>
            <input id={`text-${side}`} name={`text-${side}`} type="text" maxlength={MAX_SIDE_CHARS} autocomplete="off" enterkeyhint="done" value={preset.sides[side]?.text ?? ''} aria-describedby={[sideHelp[side] ? `help-${side}` : '', `example-${side}`, `warn-${side}`].filter(Boolean).join(' ')} class={inputClass} />
            <p class="text-sm font-medium text-foreground/80 empty:hidden" id={`example-${side}`} data-example={side}>{exampleNote(side)}</p>
            <p class="text-sm text-amber-800 empty:hidden" id={`warn-${side}`} data-warn={side}></p>
          </div>
        ))}
      </div>
      {/* Hidden until the script mounts it, like the ideas: the buttons only work with it. */}
      <div class="mt-3 flex flex-wrap gap-2" data-side-adds hidden>
        {SIDES.map((side) => (
          <button type="button" class={buttonVariants({ variant: 'outline', size: 'sm' })} aria-controls={`text-${side}`} data-side-add={side} hidden={!!preset.sides[side]?.text}>
            <Icon name="plus" /><span class="sr-only">Add Text to the </span>{SIDE_LABEL[side]} Side
          </button>
        ))}
      </div>
    </fieldset>

    <fieldset class="min-w-0">
      <legend class={legend}>Shape</legend>
      <div class="flex rounded-full bg-muted p-1">
        {Object.entries(SHAPES).map(([id, s]) => (
          <label class="flex h-10 flex-1 cursor-pointer items-center justify-center gap-2 rounded-full text-sm font-medium text-foreground/60 transition-all hover:text-foreground has-checked:bg-background has-checked:text-foreground has-checked:shadow-sm has-focus-visible:ring-3 has-focus-visible:ring-ring">
            <input type="radio" name="shape" value={id} checked={id === preset.shape} class="sr-only" />
            <svg viewBox={`-0.1 -0.1 ${s.widthIn + 0.2} ${s.heightIn + 0.2}`} class="h-5 w-auto" aria-hidden="true"><path d={s.outline} fill="none" stroke="currentColor" stroke-width="0.35" /></svg>
            {shapeName[id as keyof typeof shapeName]}
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="min-w-0">
      <legend class={cn(legend, 'max-md:sr-only')}>Background <span class="font-normal text-muted-foreground" data-background-name>{presetBackground.name}</span></legend>
      <!-- Phones: one row shows the current choice; tapping opens the sheet. -->
      <button type="button" class="flex w-full items-center gap-3 rounded-3xl bg-input/50 p-2 pr-4 text-left transition-colors outline-none hover:bg-input/80 focus-visible:ring-3 focus-visible:ring-ring md:hidden" aria-haspopup="dialog" aria-controls={pickerId} data-bg-open>
        <img src={`/backgrounds/thumb/${presetBackground.id}.webp`} alt="" width="160" height="160" class="size-11 rounded-2xl object-cover ring-1 ring-foreground/10" data-bg-thumb />
        <span class="min-w-0 flex-1">
          <span class="block text-xs text-muted-foreground">Background</span>
          <span class="block truncate font-medium" data-background-name>{presetBackground.name}</span>
        </span>
        <Icon name="chevron-right" class="size-4 text-muted-foreground" />
      </button>

      <dialog id={pickerId} class="bg-picker" aria-labelledby={`${pickerId}-title`} data-bg-picker>
        <div class="mx-auto mt-3 h-1.5 w-[100px] shrink-0 rounded-full bg-muted md:hidden" aria-hidden="true"></div>
        <div class="flex items-baseline justify-between gap-3 px-5 pt-3 pb-2 md:hidden">
          <h2 id={`${pickerId}-title`} class="text-base font-medium">Background</h2>
          <span class="truncate text-sm text-muted-foreground" data-background-name>{presetBackground.name}</span>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 pb-2 md:max-h-80 md:rounded-3xl md:bg-muted/40 md:px-3 md:pb-3" data-bg-scroll>
          {groups.map((g) => (
            <section>
              <h3 class="sticky top-0 z-10 bg-popover py-2 text-xs font-medium tracking-normal text-muted-foreground md:bg-[color-mix(in_oklch,var(--muted)_40%,var(--background))]">{g.label}</h3>
              <div class="grid grid-cols-4 gap-2 pb-2 sm:grid-cols-6 lg:grid-cols-7">
                {g.items.map((b) => (
                  <label class="relative block cursor-pointer rounded-2xl p-0.5 ring-2 ring-transparent transition-shadow has-checked:ring-foreground has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ring" title={b.name}>
                    <input type="radio" name="background" value={b.id} checked={b.id === preset.backgroundId} class="peer sr-only" />
                    <img src={`/backgrounds/thumb/${b.id}.webp`} alt="" width="160" height="160" loading="lazy" decoding="async" class="aspect-square w-full rounded-xl object-cover ring-1 ring-foreground/10" />
                    <span class="absolute top-1.5 right-1.5 hidden size-5 items-center justify-center rounded-full bg-foreground text-background peer-checked:flex"><Icon name="check" class="size-3" /></span>
                    <span class="sr-only">{b.name}</span>
                  </label>
                ))}
              </div>
            </section>
          ))}
        </div>
        <div class="border-t p-4 pb-[max(1rem,env(safe-area-inset-bottom))] md:hidden">
          <button type="button" class={cn(buttonVariants({ size: 'xl' }), 'w-full')} data-bg-done>Done</button>
        </div>
      </dialog>
    </fieldset>

    <details class="group rounded-3xl bg-muted/60" data-more>
      <summary class="flex cursor-pointer list-none items-center gap-3 rounded-3xl px-4 py-3 outline-none focus-visible:ring-3 focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
        <span class="min-w-0 flex-1">
          <span class="block text-sm font-medium">Fonts & Color</span>
          <span class="block truncate text-xs text-muted-foreground" data-more-summary>{usedFonts.join(', ')} · {colorName}</span>
        </span>
        <Icon name="chevron-down" class="size-4 text-muted-foreground transition-transform group-open:rotate-180" />
      </summary>
      <div class="grid gap-3 px-4 pt-1 pb-4 sm:grid-cols-2">
        {SIDES.map((side) => (
          <div class="grid gap-1.5" data-font-row={side} hidden={!preset.sides[side]?.text}>
            <label for={`font-${side}`} class="text-sm font-medium">{SIDE_LABEL[side]} Font</label>
            <select id={`font-${side}`} name={`font-${side}`} class={nativeSelectClass}>
              {FONTS.map((f) => <option value={f.id} selected={(preset.sides[side]?.fontId ?? 'playfair-display-bold') === f.id}>{fontName(f.id)}</option>)}
            </select>
          </div>
        ))}
        <div class="grid gap-1.5 sm:col-span-2">
          <label for="text-color" class="text-sm font-medium">Text Color</label>
          <select id="text-color" name="color" class={nativeSelectClass}>
            <option value="auto" selected={presetColor === 'auto'}>Best for the Background</option>
            {TEXT_COLORS.map((c) => <option value={c.hex} selected={presetColor === c.hex}>{c.name}</option>)}
          </select>
        </div>
      </div>
    </details>

    <button type="button" class={cn(buttonVariants({ variant: 'link', size: 'sm' }), 'self-start px-0')} data-reset hidden>
      <Icon name="rotate-ccw" class="size-3.5" />Start Over with Our Design
    </button>

    <!-- Marks where the cart bar comes to rest, for the preview to be pushed away from it
         on phones. Zero height; its negative margin cancels the column gap it adds. -->
    <div class="bar-mark -mb-6" aria-hidden="true"></div>
    <!-- Always in reach: the frame is buyable as designed. A bar on phones, a floating card from md up. -->
    <div class="sticky bottom-0 z-20 -mx-4 border-t bg-background/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-sm md:bottom-4 md:mx-0 md:rounded-4xl md:border-0 md:p-3 md:shadow-lg md:ring-1 md:ring-foreground/5">
      <p class="text-sm font-medium [&:not(:empty)]:mb-2 [&_a]:underline" role="status" aria-live="polite" data-status></p>
      <button type="submit" class={cn(buttonVariants({ size: 'xl' }), 'w-full')} data-add>Add to Cart · {price}</button>
      {/* After an add the shopper stays here; the next step is checkout, not the product page. */}
      <a href="/cart" class={cn(buttonVariants({ size: 'xl' }), 'w-full')} data-added hidden>View Cart & Check Out</a>
    </div>

    <ul class="grid gap-2 text-sm text-muted-foreground [&_svg]:shrink-0">
      <li class="flex items-center gap-2"><Icon name="clock" />{SHOP.dispatch}</li>
      <li class="flex items-center gap-2"><Icon name="truck" />{SHOP.shipping}</li>
      <li class="flex items-center gap-2"><Icon name="frame" />8.4 × 6.4 inch wood frame with glass and an easel back</li>
      <li class="flex items-center gap-2"><Icon name="heart" />{SHOP.photoNote}</li>
    </ul>
  </form>
</div>

<script>
  import { mountCustomizer } from '../scripts/customizer';
  document.querySelectorAll<HTMLElement>('[data-customizer]').forEach(mountCustomizer);
</script>

<style>
  .idea :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Phones: cap the sticky preview so the options stay in view under it. */
  .preview :global(svg) {
    height: min(30svh, 68vw);
    width: 100%;
  }
  @media (min-width: 48rem) {
    .preview :global(svg) {
      height: auto;
    }
  }

  /* Phones: the docked preview's exact height (padding 0.5 + 0.75 + 0.75 + 0.75rem around
     the drawing), so the push below moves it one pixel per pixel scrolled. */
  @media not all and (min-width: 48rem) {
    .customizer {
      --dock-h: calc(min(30svh, 68vw) + 2.75rem);
    }
    .preview-dock {
      height: var(--dock-h);
    }
  }

  /* Phones: the options scroll under the sticky preview. A hard edge cuts a field or a
     line of text in half there, so the preview's bottom edge fades into the page instead.
     The fade only exists once something is under it: it grows from nothing over the
     first 3rem of scroll after the preview docks (the editor's top edge passing the top
     of the screen, whatever its height), read from the editor's own scroll
     position (a view timeline), so the page at rest shows no fade over the heading.
     Without scroll-driven animation support the edge stays hard, as before. Nothing
     moves on its own: the fade tracks the shopper's scroll, so it holds under reduced
     motion too. The overlay takes no taps, so a field half under it still works. */
  @property --dock-fade {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  @keyframes dock-fade {
    from {
      --dock-fade: 0px;
    }
    to {
      --dock-fade: 2rem;
    }
  }
  /* Phones, at the end of the options: the cart bar stops being pinned to the bottom of
     the screen and rides up with the page. Pinned at the top, the preview used to stay put
     and the bar slid over its middle, with the last details hidden under it. Now the bar
     pushes the preview up and off the screen as it arrives, one pixel per pixel scrolled,
     so the two never overlap. The push is read from where the bar comes to rest (a view
     timeline on .bar-mark): it starts when that spot meets the preview's bottom and ends
     when it reaches the top of the screen. The bottom fade goes in the 2rem before, so it
     never sits on the bar. */
  @keyframes dock-push {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 calc(-1 * var(--dock-h));
    }
  }
  @keyframes dock-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @supports (animation-timeline: view()) {
    @media not all and (min-width: 48rem) {
      .customizer {
        view-timeline: --editor block;
        timeline-scope: --bar;
      }
      .bar-mark {
        view-timeline: --bar block;
      }
      .preview-dock {
        animation: dock-push linear both;
      }
      .customizer .preview-dock {
        animation-timeline: --bar;
        animation-range: cover calc(100% - var(--dock-h)) cover 100%;
      }
      .preview-dock::after {
        content: '';
        position: absolute;
        inset-inline: 0;
        top: 100%;
        height: var(--dock-fade);
        background: linear-gradient(
          var(--background),
          color-mix(in oklab, var(--background) 60%, transparent) 45%,
          transparent
        );
        pointer-events: none;
        animation:
          dock-fade linear both,
          dock-fade-out linear both;
      }
      /* Timelines in their own rules, after the shorthands: the minifier folds a timeline in
         the same rule into the shorthand, which browsers drop. */
      .customizer .preview-dock::after {
        animation-timeline: --editor, --bar;
        animation-range:
          exit-crossing 0% exit-crossing 3rem,
          cover calc(100% - var(--dock-h) - 2rem) cover calc(100% - var(--dock-h));
      }
    }
  }
</style>
