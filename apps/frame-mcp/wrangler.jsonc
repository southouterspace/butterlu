{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level is stage, so a bare wrangler command can never reach production.
  // Production is env.production, deployed only by .github/workflows/release.yml
  // on a GitHub Release the owner publishes. Butterlu's own Cloudflare account;
  // scripts/deploy.mjs refuses any other.
  "account_id": "5fa9365455451e1db238dedb838fc9ff",
  "name": "butterlu-frame-mcp-stage",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Backgrounds and fonts ship with the Worker (scripts/prepare-assets.mjs fills
  // build/assets). run_worker_first: every request reaches the Worker first, so
  // nothing in build/assets is served to the public; the code reads it through
  // the ASSETS binding. No R2 needed.
  "assets": { "directory": "./build/assets", "binding": "ASSETS", "run_worker_first": true },
  // Secrets, set per Worker (never here): MCP_TOKEN, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN, DRIVE_FOLDER_ID,
  // DRIVE_PROOF_FOLDER_ID. Stage and production get different Drive folders.
  "env": {
    "production": {
      "name": "butterlu-frame-mcp",
      "assets": { "directory": "./build/assets", "binding": "ASSETS", "run_worker_first": true }
    }
  }
}
