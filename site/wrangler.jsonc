{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The account also hosts fourfold* and rps-worker; keep this name distinct.
  "name": "butterlu-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Previews inherit the top-level config; bindings that must not touch
  // production data get overridden here (docs/07: previews get their own D1).
  "previews": {}
}
