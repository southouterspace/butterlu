---
// The store editor (docs/13). Built like any page, but the Worker serves it only after
// the admin sign-in (worker/admin.ts) and it is never in the sitemap. All content
// loads from /api/admin/catalog after sign-in, so the built file holds no catalog data.
import '../../styles/global.css';
import '../../admin/admin.css';
import { PHOTO_FILES } from '../../catalog/media';
import { ILLUSTRATIONS } from '../../catalog/illustrations';
import { illustrationImage } from '../../catalog/illustration-images';
// The card drawings' URLs, for the Shop by picker's preview.
const illustrationUrls = Object.fromEntries(ILLUSTRATIONS.map((i) => [i.key, illustrationImage(i.key).src]));
// The photo files the build has, for the page components' photo picker. File names only.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Store admin · Butterlu</title>
    <meta name="description" content="Butterlu's private store editor for designs, categories and search copy." />
    <link rel="canonical" href="https://www.butterlu.com/admin/catalog" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div id="admin"><p class="loading">Loading the store…</p></div>
    <p id="toast-live" class="visually-hidden" role="status"></p>
    <script id="photo-files" type="application/json" set:html={JSON.stringify(PHOTO_FILES).replace(/</g, "\\u003c")} />
    <script id="illustration-urls" type="application/json" set:html={JSON.stringify(illustrationUrls).replace(/</g, "\\u003c")} />
    <script>
      import '../../admin/app';
    </script>
  </body>
</html>
