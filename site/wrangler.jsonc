{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top level is stage, so a bare wrangler command can never reach production.
  // Production is env.production, deployed only by .github/workflows/release.yml.
  // The account also hosts fourfold* and rps-worker; keep these names distinct.
  "name": "butterlu-site-stage",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Previews belong to the stage Worker. Bindings that must not touch stage
  // data get overridden here (docs/07: previews get their own D1).
  "previews": {},
  "env": {
    "production": {
      "name": "butterlu-site"
    }
  }
}
