---
// The Questions page: the store's shared questions (src/catalog/pages.json), the same
// list collection and product pages show, edited under Questions in the admin.
import Layout from '../../Layout.astro';
import Questions from '../../components/sections/Questions.astro';
import { liveQuestions } from '../../catalog/pages';

// FAQPage markup goes on this page only: the list is the same everywhere else.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: liveQuestions().map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Layout title="Questions | Butterlu" description="Proofs, changes after you order, delivery, photos, gifting and returns: what to know before you order a Butterlu frame." jsonLd={jsonLd}>
  <div class="prose">
    <h1>Questions</h1>
    <Questions />
  </div>
</Layout>
