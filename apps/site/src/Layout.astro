---
import { COLLECTIONS } from './catalog/products';
import { CREATE_HREF, OCCASIONS, MENU_GROUPS, groupHref, occasionHref, recipientHref } from './catalog/taxonomy';
import Icon from './components/ui/Icon.astro';
import { badgeVariants, buttonVariants, cn } from './components/ui/variants';
import './styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Structured data objects, each emitted as its own JSON-LD script. */
  jsonLd?: object[];
  /** Keep the page out of search results (cart, checkout result). */
  noindex?: boolean;
  /** Link-preview image (og:image), an absolute or root-relative URL to a raster. */
  image?: { src: string; width: number; height: number; alt: string };
  ogType?: 'website' | 'product';
}
const { title, description, jsonLd = [], noindex = false, image, ogType = 'website' } = Astro.props;
// With build.format 'file', Astro.url.pathname is the output file at build time
// ("/index.html", "/products/x.html"). Pages are served without the extension, so
// strip it for the canonical, og:url and the nav's current-page match.
const path = Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/';
const canonical = new URL(path, Astro.site);
// Shop menus (docs/12 §4c): who it's for, then occasion. Groups open their category;
// a person or occasion without its own category opens the page filtered.
const current = (href: string) => (path === href ? 'page' : undefined);
const menuLink = 'block rounded-2xl px-3 py-2 text-foreground no-underline hover:bg-muted aria-[current=page]:bg-muted';
const triggerClass = cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'text-muted-foreground');
// Funnel step for the page-view beacon (docs/11). `path` above already has the
// build file name (/index.html, /cart.html) stripped.
const page = path;
const [, section = '', slug] = page.split('/');
const pageType =
  page === '/' ? 'home'
  : section === 'products' ? 'product'
  : section === 'collections' ? 'collection'
  : page === '/cart' ? 'cart'
  : page === '/checkout/success' ? 'success'
  : section === 'pages' ? 'content'
  : page === '/404' ? 'not_found'
  : 'other';
const pageHandle = pageType === 'product' || pageType === 'collection' ? slug : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Butterlu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    {image && (
      <>
        <meta property="og:image" content={new URL(image.src, Astro.site)} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={image.alt} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <!-- Playfair is the wordmark's face as well as a frame font, so every page wants it early. -->
    <link rel="preload" href="/fonts/playfair-display-bold.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Filter chips need script (components/FilterBar.astro); without it the full grid shows. -->
    <noscript><style>[data-filters] { display: none; }</style></noscript>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-svh flex-col" data-page-type={pageType} data-handle={pageHandle}>
    <a class="sr-only z-50 rounded-3xl bg-background px-3 py-2 focus:not-sr-only focus:fixed focus:top-2 focus:left-2" href="#main">Skip to content</a>
    <header class="border-b">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-4 md:h-16">
        <!-- Phones and tablets: the nav lives in a native popover sheet (no script). -->
        <button type="button" class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), '-ml-2 lg:hidden')} popovertarget="site-menu" aria-label="Menu">
          <Icon name="menu" class="size-5" />
        </button>
        <a class="font-brand text-2xl font-bold tracking-tight text-foreground no-underline" href="/" aria-label="Butterlu home">Butterlu</a>
        <nav class="ml-6 hidden lg:block" aria-label="Shop">
          <ul class="flex items-center gap-1">
            <li><button type="button" class={triggerClass} popovertarget="menu-for">Who It’s For <Icon name="chevron-down" class="size-4" /></button></li>
            <li><button type="button" class={triggerClass} popovertarget="menu-occasion">Occasion <Icon name="chevron-down" class="size-4" /></button></li>
            <li><a class={cn(triggerClass, 'aria-[current=page]:bg-muted aria-[current=page]:text-foreground')} href="/collections/all" aria-current={current('/collections/all')}>Shop All</a></li>
          </ul>
        </nav>
        <a class={cn(buttonVariants({ variant: 'ghost', size: 'default' }), 'ml-auto -mr-2')} href="/cart">
          <Icon name="shopping-bag" class="size-5" />
          <span class="max-sm:sr-only">Cart</span>
          <span class={badgeVariants()} data-cart-count>0</span><span class="sr-only"> items</span>
        </a>
      </div>
    </header>
    <nav id="menu-for" popover class="shop-panel" aria-labelledby="menu-for-title">
      <p id="menu-for-title" class="mb-3 text-xs font-medium tracking-wide text-muted-foreground uppercase">Who It’s For</p>
      <ul class="grid gap-x-6 gap-y-5 sm:grid-cols-3">
        {MENU_GROUPS.map((g) => (
          <li>
            <a class={cn(menuLink, 'font-medium')} href={groupHref(g)} aria-current={current(groupHref(g))}>{g.label}</a>
            {g.children.length > 1 && (
              <ul class="mt-0.5 text-sm">
                {g.children.map((r) => <li><a class={menuLink} href={recipientHref(r)}>{r.label}{r.hint && <span class="block text-xs text-muted-foreground">{r.hint}</span>}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <nav id="menu-occasion" popover class="shop-panel" aria-label="Occasion">
      <div class="grid gap-6 sm:grid-cols-[2fr_1fr]">
        <div>
          <p class="mb-3 text-xs font-medium tracking-wide text-muted-foreground uppercase">Occasion</p>
          <ul class="grid gap-0.5 text-sm sm:grid-cols-2">{OCCASIONS.map((o) => <li><a class={menuLink} href={occasionHref(o)} aria-current={current(occasionHref(o))}>{o.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="mb-3 text-xs font-medium tracking-wide text-muted-foreground uppercase">Your Own Words</p>
          <ul class="grid gap-0.5 text-sm"><li><a class={menuLink} href={CREATE_HREF}>Create Your Own Frame</a></li></ul>
        </div>
      </div>
    </nav>
    <div id="site-menu" popover class="site-menu">
      <div class="flex items-center justify-between p-4">
        <span class="font-brand text-xl font-bold">Butterlu</span>
        <button type="button" class={buttonVariants({ variant: 'ghost', size: 'icon' })} popovertarget="site-menu" popovertargetaction="hide" aria-label="Close menu">
          <Icon name="x" class="size-5" />
        </button>
      </div>
      <nav aria-label="Shop (menu)" class="px-2">
        <a class="flex h-11 items-center rounded-2xl px-3 text-base font-medium text-foreground no-underline hover:bg-muted aria-[current=page]:bg-muted" href="/collections/all" aria-current={current('/collections/all')}>Shop All</a>
        <details open class="menu-section">
          <summary>Who It’s For <Icon name="chevron-down" class="size-4" /></summary>
          <ul class="grid gap-0.5 pb-2">
            {MENU_GROUPS.map((g) => (
              <li>
                <a class="flex h-10 items-center rounded-2xl px-3 text-foreground no-underline hover:bg-muted aria-[current=page]:bg-muted" href={groupHref(g)} aria-current={current(groupHref(g))}>{g.label}</a>
                {g.children.length > 1 && (
                  <ul class="mb-1 ml-3 grid gap-0.5 border-l pl-2 text-sm">
                    {g.children.map((r) => <li><a class="flex h-9 items-center rounded-2xl px-3 text-muted-foreground no-underline hover:bg-muted hover:text-foreground" href={recipientHref(r)}>{r.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </details>
        <details class="menu-section">
          <summary>Occasion <Icon name="chevron-down" class="size-4" /></summary>
          <ul class="grid gap-0.5 pb-2">
            {OCCASIONS.map((o) => <li><a class="flex h-10 items-center rounded-2xl px-3 text-foreground no-underline hover:bg-muted aria-[current=page]:bg-muted" href={occasionHref(o)} aria-current={current(occasionHref(o))}>{o.label}</a></li>)}
          </ul>
        </details>
        <ul class="mt-4 grid gap-0.5 border-t pt-4">
          <li><a class="flex h-10 items-center rounded-2xl px-3 text-sm text-muted-foreground no-underline hover:bg-muted" href="/pages/shipping-returns">Shipping & Returns</a></li>
          <li><a class="flex h-10 items-center rounded-2xl px-3 text-sm text-muted-foreground no-underline hover:bg-muted" href="/pages/faq">Questions</a></li>
          <li><a class="flex h-10 items-center rounded-2xl px-3 text-sm text-muted-foreground no-underline hover:bg-muted" href="/pages/about">About Butterlu</a></li>
        </ul>
      </nav>
    </div>
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 pt-4 pb-14 md:pt-8">
      <slot />
    </main>
    <footer class="border-t bg-muted/40 py-10 text-sm text-muted-foreground">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 md:grid-cols-[2fr_1fr_1fr]">
        <div class="col-span-2 md:col-span-1">
          <p class="font-brand text-xl font-bold text-foreground">Butterlu</p>
          <p class="mt-2 max-w-sm">Personalized frames for the people you want to celebrate and remember, made to order.</p>
        </div>
        <nav aria-label="Collections">
          <h2 class="mb-3 text-xs font-medium tracking-wide text-foreground uppercase">Shop</h2>
          <ul class="grid gap-2">{COLLECTIONS.map((c) => <li><a class="no-underline hover:text-foreground hover:underline" href={`/collections/${c.handle}`}>{c.name}</a></li>)}</ul>
        </nav>
        <nav aria-label="Help">
          <h2 class="mb-3 text-xs font-medium tracking-wide text-foreground uppercase">Help</h2>
          <ul class="grid gap-2">
            <li><a class="no-underline hover:text-foreground hover:underline" href="/pages/shipping-returns">Shipping & Returns</a></li>
            <li><a class="no-underline hover:text-foreground hover:underline" href="/pages/faq">Questions</a></li>
            <li><a class="no-underline hover:text-foreground hover:underline" href="/pages/about">About Butterlu</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      import { cartCount, onCartChange } from './scripts/cart';
      import { referrerHost, track } from './scripts/track';
      track('view', { r: referrerHost() });
      const render = () => document.querySelectorAll('[data-cart-count]').forEach((el) => (el.textContent = String(cartCount())));
      render();
      onCartChange(render);

      // Card art below the fold: SVG <image> has no loading="lazy", so the
      // background is fetched only when its card nears the viewport.
      const lazy = document.querySelectorAll<SVGSVGElement>('svg[data-lazy]');
      if (lazy.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const img = e.target.querySelector('image[data-href]');
              if (img) img.setAttribute('href', img.getAttribute('data-href')!);
              io.unobserve(e.target);
            }
          },
          { rootMargin: '400px 0px' },
        );
        lazy.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  /* Phones' nav: shadcn Sheet shape (left side) on the native popover API, so it
     opens, closes on Escape or an outside tap, and traps nothing, with no script. */
  .site-menu {
    inset: 0 auto 0 0;
    margin: 0;
    height: 100dvh;
    width: min(20rem, 85vw);
    padding: 0;
    border: 0;
    border-right: 1px solid var(--border);
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow: 0 0 40px oklch(0 0 0 / 0.14);
    translate: -100% 0;
    transition:
      translate 200ms ease-in-out,
      display 200ms allow-discrete,
      overlay 200ms allow-discrete;
  }
  .site-menu:popover-open {
    translate: 0 0;
  }
  @starting-style {
    .site-menu:popover-open {
      translate: -100% 0;
    }
  }
  /* Desktop shop menus: a panel under the header on the native popover API. */
  /* Absolute, not the popover's default fixed: the header doesn't stick, so the panel
     scrolls away with it. */
  .shop-panel {
    position: absolute;
    inset: 4.25rem 0 auto 0;
    margin: 0 auto;
    width: min(56rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 5.5rem);
    overflow: auto;
    padding: 1.25rem 1.5rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1.75rem;
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow: 0 12px 40px oklch(0 0 0 / 0.12);
  }
  .menu-section {
    border-top: 1px solid var(--border);
    margin-top: 0.5rem;
  }
  .menu-section > summary {
    display: flex;
    height: 2.75rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .menu-section > summary::-webkit-details-marker {
    display: none;
  }
  .menu-section[open] > summary svg {
    rotate: 180deg;
  }
  .site-menu::backdrop {
    background: oklch(0 0 0 / 0.3);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-menu {
      transition: none;
    }
  }
</style>
