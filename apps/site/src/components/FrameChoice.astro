---
// The two frames Butterlu sells, shown above every list of designs so the page reads
// as two products with many starting points, not a grid of look-alike products.
import { FRAMES, SHOP, formatPrice, FRAME_PRICE_CENTS } from '../catalog/products';
import ProductCard from './ProductCard.astro';

interface Props {
  /** Heading id, unique on the page. Shown once per page, as an h2 with h3 cards. */
  id?: string;
}
const { id = 'frames' } = Astro.props;
---
<section aria-labelledby={id} class="rounded-4xl bg-muted/60 p-4 sm:p-6">
  <h2 id={id} class="text-lg md:text-xl">Two frames, your words</h2>
  <p class="mt-1 mb-4 text-sm text-muted-foreground">
    Every design comes on one of these. {formatPrice(FRAME_PRICE_CENTS)} either way. {SHOP.shipping}. Start blank or from a design.
  </p>
  <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:max-w-xl">{FRAMES.map((f) => <ProductCard product={f} headingLevel="h3" eager />)}</ul>
</section>
