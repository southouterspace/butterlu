---
// Filters over a grid of design cards: who it's for and occasion. Shown from the first
// paint so nothing shifts; hidden only for visitors without script, who see the full grid.
// src/scripts/filters.ts makes them work.
// One Filter button opens the chips in a modal <dialog>, so the designs come first at
// every width: a bottom sheet on phones, a drawer from the left edge from md up.
// The chosen filters live in the query string (?for=grandma&occasion=christmas) and
// the page's canonical stays the category, so a filtered view is never indexed.
import type { Facet } from '../catalog/taxonomy';
import Icon from './ui/Icon.astro';
import { buttonVariants, cn } from './ui/variants';

interface Props {
  facets: Facet[];
  /** Total designs in the grid. */
  total: number;
}
const { facets, total } = Astro.props;
const chip =
  'inline-flex h-9 items-center gap-1.5 rounded-full border px-3.5 text-sm font-medium text-foreground transition-colors hover:bg-muted aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background';
const sheetId = 'filter-sheet';
---
{facets.length > 0 && (
  <div data-filters class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-3">
    <button type="button" class={buttonVariants({ variant: 'outline', size: 'lg' })} aria-haspopup="dialog" aria-controls={sheetId} data-filter-open>
      <Icon name="sliders-horizontal" />
      Filter
      <span data-filter-count hidden class="ml-0.5 inline-flex size-5 items-center justify-center rounded-full bg-foreground text-xs text-background"></span>
    </button>
    <dialog id={sheetId} class="filter-sheet" aria-labelledby={`${sheetId}-title`} data-filter-sheet>
      <div class="mx-auto mt-3 h-1.5 w-[100px] shrink-0 rounded-full bg-muted md:hidden" aria-hidden="true"></div>
      <div class="flex items-center justify-between gap-2 px-5 pt-3 pb-1 md:pt-5 md:pb-2">
        <h2 id={`${sheetId}-title`} class="text-base font-medium md:text-lg">Filter Designs</h2>
        <button type="button" class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'hidden md:inline-flex')} aria-label="Close" data-filter-close>
          <Icon name="x" class="size-5" />
        </button>
      </div>
      <div class="grid min-h-0 flex-1 content-start gap-4 overflow-y-auto overscroll-contain px-5 py-3 md:gap-6">
        {facets.map((f) => (
          <div role="group" aria-label={f.label} class="flex flex-wrap items-center gap-2">
            <span class="w-full text-xs font-medium tracking-wide text-muted-foreground uppercase">{f.label}</span>
            {f.options.map((o) => (
              <button type="button" class={chip} data-filter={f.param} data-value={o.key} aria-pressed="false">
                {o.label}
              </button>
            ))}
          </div>
        ))}
      </div>
      <div class="grid grid-cols-[auto_1fr] gap-2 border-t px-5 pt-3 pb-[max(1rem,env(safe-area-inset-bottom))] md:pb-5">
        <button type="button" class={buttonVariants({ variant: 'outline', size: 'lg' })} data-filter-clear="sheet" disabled>Clear</button>
        <button type="button" class={buttonVariants({ size: 'lg' })} data-filter-done>Show {total} Designs</button>
      </div>
      <span class="sr-only" role="status" data-filter-sheet-status></span>
    </dialog>
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
      <span data-filter-status role="status" tabindex="-1">Showing all {total} designs</span>
      <button type="button" data-filter-clear hidden class={cn('underline underline-offset-4 hover:text-foreground')}>Clear Filters</button>
    </p>
  </div>
)}
<p data-filter-empty hidden class="mb-5 rounded-3xl bg-muted/60 p-5 text-sm">
  No designs match all of those yet. Any design can be changed to fit, or <a href="#create" class="underline underline-offset-4">create your own frame</a>.
</p>
