---
// A frame or design tile in the shadcn Card shape, rendered as static HTML.
// A design card offers the ways in that every category has (owner, 2026-11-11): add it
// to the cart exactly as shown in one tap when its wording needs no names or dates, or
// open it to personalize. Making a frame from scratch is the FrameChoice block.
import { type Product, formatPrice, isFrame, readyAsShown } from '../catalog/products';
import { tagsFor } from '../catalog/taxonomy';
import { frameSvg } from '../lib/frame-svg';
import { placementsAtBuild } from '../lib/layout-build';
import { buttonVariants, cardClass, cn } from './ui/variants';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
  /** Load the art at once; for the first row. Later cards wait until scrolled near. */
  eager?: boolean;
}
const { product, headingLevel = 'h3', eager = false } = Astro.props;
const Heading = headingLevel;
// Category filters read these (src/scripts/filters.ts); the frame carries none.
const tags = tagsFor(product);
const svg = frameSvg(product.preset, placementsAtBuild(product.preset), { idPrefix: `card-${product.handle}`, photoHint: false, size: 'card', lazy: !eager });
const frame = isFrame(product);
const quick = !frame && readyAsShown(product);
const href = `/products/${product.handle}`;
const titleId = `card-title-${product.handle}`;
---
<li
  class={cn(cardClass, 'flex flex-col shadow-sm transition-shadow hover:shadow-md')}
  data-card={tags ? '' : undefined}
  data-for={tags ? `${tags.group.key} ${tags.for.key}` : undefined}
  data-occasion={tags?.occasions.map((o) => o.key).join(' ')}
>
  <a href={href} class="group flex flex-1 flex-col text-foreground no-underline">
    <div class="bg-muted p-3 sm:p-5" set:html={svg} />
    <div class="grid gap-1 p-3 sm:p-4">
      <Heading id={titleId} class="text-sm leading-snug font-medium tracking-normal group-hover:underline sm:text-base">{product.name}</Heading>
      <span class="text-sm text-muted-foreground">
        {formatPrice(product.priceCents)}
      </span>
    </div>
  </a>
  {!frame && (
    <div class="flex flex-wrap gap-2 px-3 pb-3 sm:px-4 sm:pb-4">
      {quick && (
        <button
          type="button"
          class={cn(buttonVariants({ size: 'sm' }), 'flex-1')}
          data-add-as-shown={product.handle}
          data-spec={JSON.stringify(product.preset)}
          aria-label={`Add to Cart: ${product.name}, as shown`}
        >
          Add to Cart
        </button>
      )}
      <a
        href={href}
        class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'h-auto min-h-8 flex-1 py-1 text-center whitespace-normal')}
        aria-label={`${quick ? 'Personalize' : 'Add Your Words'}: ${product.name}`}
      >
        {quick ? 'Personalize' : 'Add Your Words'}
      </a>
      {/* Rendered from the start, so screen readers announce the update. */}
      {quick && <p class="w-full text-xs text-muted-foreground" role="status" data-added-status></p>}
    </div>
  )}
</li>
<script>
  import type { FrameSpec } from '@butterlu/frame';
  import { addToCart, cartLines } from '../scripts/cart';
  import { track } from '../scripts/track';

  // One listener for every card on the page. The checkout Worker re-checks each line.
  document.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-add-as-shown]');
    if (!button) return;
    const spec = JSON.parse(button.dataset.spec ?? 'null') as FrameSpec | null;
    if (!spec) return;
    const handle = button.dataset.addAsShown!;
    addToCart(handle, spec, 1);
    track('add_to_cart', { d: 'as_shown_card', h: handle });
    const status = button.parentElement?.querySelector<HTMLElement>('[data-added-status]');
    const n = cartLines().filter((l) => l.handle === handle).reduce((sum, l) => sum + l.quantity, 0);
    if (status) status.innerHTML = `Added to your cart${n > 1 ? ` (${n} of these)` : ''}. <a href="/cart" class="underline underline-offset-4">View cart</a>`;
  });
</script>
