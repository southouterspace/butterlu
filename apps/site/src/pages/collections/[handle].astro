---
import Layout from '../../Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { COLLECTIONS, type Collection, PRODUCTS, collectionProducts } from '../../catalog/products';

export function getStaticPaths() {
  const all: Collection = {
    handle: 'all',
    name: 'All frames',
    seoTitle: 'Personalized Picture Frames: Shop All',
    seoDescription: 'Every Butterlu frame: grandparents, godparents, weddings, baby and pet memorials. Personalized wording, two shapes, 44 backgrounds.',
    intro: 'Every design starts from the same handmade frame. Pick the one closest to your occasion, then make it yours.',
  };
  return [all, ...COLLECTIONS].map((collection) => ({ params: { handle: collection.handle }, props: { collection } }));
}

interface Props {
  collection: Collection;
}
const { collection } = Astro.props;
const products = collection.handle === 'all' ? PRODUCTS : collectionProducts(collection.handle);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: collection.name,
    description: collection.seoDescription,
    hasPart: products.map((p) => ({ '@type': 'Product', name: p.name, url: new URL(`/products/${p.handle}`, Astro.site).href })),
  },
];
---
<Layout title={`${collection.seoTitle} | Butterlu`} description={collection.seoDescription} jsonLd={jsonLd}>
  <h1 class="text-2xl md:text-3xl">{collection.name}</h1>
  <p class="mt-2 max-w-[60ch] text-muted-foreground">{collection.intro}</p>
  <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">{products.map((p, i) => <ProductCard product={p} eager={i < 4} headingLevel="h2" />)}</ul>
</Layout>

