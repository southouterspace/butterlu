---
import Layout from '../Layout.astro';
import { PRODUCTS, SHOP } from '../catalog/products';
import { buttonVariants, cn } from '../components/ui/variants';

// Names and prices for display only. The checkout Worker prices every line itself.
const catalog = Object.fromEntries(PRODUCTS.map((p) => [p.handle, { name: p.name, priceCents: p.priceCents }]));
---
<Layout title="Your Cart | Butterlu" description="Review your personalized frames and check out." noindex>
  <h1 class="text-2xl md:text-3xl">Your cart</h1>
  <div class="mt-6 grid gap-6 md:grid-cols-[minmax(0,1fr)_20rem] md:items-start" data-cart data-catalog={JSON.stringify(catalog)}>
    <p class="text-muted-foreground" data-empty>Your cart is empty. <a class="text-foreground underline" href="/collections/all">Find a frame</a></p>
    <ul class="grid gap-3" data-lines></ul>
    <div class="grid gap-3 rounded-4xl bg-card p-5 shadow-sm ring-1 ring-foreground/5 md:sticky md:top-6" data-summary hidden>
      <p class="flex justify-between text-base font-semibold">Subtotal <span data-subtotal></span></p>
      <p class="text-sm text-muted-foreground">{SHOP.shipping}. Tax, if any, is added at checkout.</p>
      <button type="button" class={cn(buttonVariants({ size: 'xl' }), 'w-full')} data-checkout>Check out</button>
      <p class="text-sm" role="status" aria-live="polite" data-status></p>
    </div>
  </div>
</Layout>

<script>
  import { mountCart } from '../scripts/cart-page';
  const root = document.querySelector<HTMLElement>('[data-cart]');
  if (root) mountCart(root);
</script>

