---
import Layout from '../../Layout.astro';
import FilterBar from '../../components/FilterBar.astro';
import FrameChoice from '../../components/FrameChoice.astro';
import ProductCard from '../../components/ProductCard.astro';
import { buttonVariants } from '../../components/ui/variants';
import { byBestSelling } from '../../catalog/best-selling';
import { COLLECTIONS, type Collection, DESIGNS, collectionProducts } from '../../catalog/products';
import { collectionCopy } from '../../catalog/copy';
import { facetsFor } from '../../catalog/taxonomy';

export function getStaticPaths() {
  const all: Collection = {
    handle: 'all',
    name: 'All Frames',
    seoTitle: 'Personalized Picture Frames: Shop All',
    seoDescription: 'Every Butterlu frame: grandparents, godparents, weddings, new babies and pet memorials. Add their names and your words, and see it before you buy.',
    intro: 'Ready to give, or make it yours.',
  };
  return [all, ...COLLECTIONS].map((collection) => ({ params: { handle: collection.handle }, props: { collection } }));
}

interface Props {
  collection: Collection;
}
const { collection } = Astro.props;
// Designs only: the plain frame follows the grid as "Create your own frame".
// Shop All opens best selling first (catalog/best-selling.ts, set by hand for now).
const products = collection.handle === 'all' ? byBestSelling(DESIGNS) : collectionProducts(collection.handle);
// Shop all filters by who-it's-for group; a category by the people on it (docs/12 §4c).
const facets = facetsFor(products, collection.handle === 'all' ? 'group' : 'recipient');
// Copy, FAQ and sibling links below the grid (docs/12-serp-leadership.md §5).
const copy = collectionCopy(collection.handle);
const related = (copy?.related ?? []).map((h) => COLLECTIONS.find((c) => c.handle === h)).filter((c): c is Collection => Boolean(c));
const productUrl = (handle: string) => new URL(`/products/${handle}`, Astro.site).href;
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: collection.name,
    description: collection.seoDescription,
    url: new URL(`/collections/${collection.handle}`, Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: products.length,
      itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: productUrl(p.handle), name: p.name })),
    },
  },
];
if (copy?.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  });
}
---
<Layout title={`${collection.seoTitle} | Butterlu`} description={collection.seoDescription} jsonLd={jsonLd}>
  <h1 class="text-2xl md:text-3xl">{collection.name}</h1>
  <p class="mt-2 max-w-[60ch] text-muted-foreground">{collection.intro}</p>
  <section aria-label="Designs" class="mt-6">
    <FilterBar facets={facets} total={products.length} />
    <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">{products.map((p, i) => <ProductCard product={p} eager={i < 2} />)}</ul>
    {/* Applies a menu link's filter before first paint, so the full grid doesn't flash. filters.ts takes over once loaded. */}
    <script is:inline>
      (() => {
        const q = new URLSearchParams(location.search);
        const s = {};
        for (const p of ['for', 'occasion']) {
          const v = q.get(p);
          if (v && document.querySelector(`[data-filter="${p}"][data-value="${CSS.escape(v)}"]`)) s[p] = v;
        }
        if (!Object.keys(s).length) return;
        const cards = document.querySelectorAll('[data-card]');
        let shown = 0;
        for (const c of cards) {
          c.hidden = !Object.entries(s).every(([p, v]) => (c.getAttribute(`data-${p}`) || '').split(' ').includes(v));
          if (!c.hidden) shown++;
        }
        for (const b of document.querySelectorAll('[data-filter]')) b.setAttribute('aria-pressed', String(s[b.dataset.filter] === b.dataset.value));
        const status = document.querySelector('[data-filter-status]');
        if (status) status.textContent = `Showing ${shown} of ${cards.length} designs`;
        const count = document.querySelector('[data-filter-count]');
        if (count) {
          count.hidden = false;
          count.textContent = String(Object.keys(s).length);
        }
      })();
    </script>
  </section>
  <div class="mt-10"><FrameChoice /></div>
  {copy && (
    <div class="mt-12 grid gap-10 border-t pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
      <section class="prose" aria-label={`About ${collection.name.toLowerCase()}`}>{copy.body.map((para) => <p>{para}</p>)}</section>
      {copy.faq.length > 0 && (
        <section class="prose" aria-labelledby="faq">
          <h2 id="faq">Questions</h2>
          {copy.faq.map(([q, a]) => (<><h3>{q}</h3><p>{a}</p></>))}
        </section>
      )}
    </div>
  )}
  {related.length > 0 && (
    <nav aria-labelledby="more" class="mt-10 border-t pt-6">
      <h2 id="more" class="mb-3 text-lg">You might also like</h2>
      <ul class="flex flex-wrap gap-2">{related.map((c) => <li><a class={buttonVariants({ variant: 'outline' })} href={`/collections/${c.handle}`}>{c.name}</a></li>)}</ul>
    </nav>
  )}
</Layout>
<script>
  import { mountFilters } from '../../scripts/filters';
  mountFilters();
</script>
