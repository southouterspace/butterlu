{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top level is stage, so a bare wrangler command can never reach production.
  // Production is env.production, deployed only by .github/workflows/release.yml.
  // Butterlu has its own Cloudflare account, shared with no other project.
  // scripts/deploy.mjs refuses any other account.
  "account_id": "5fa9365455451e1db238dedb838fc9ff",
  "name": "butterlu-site-stage",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/*"]
  },
  "observability": { "enabled": true },
  // Checkout and recovery controls (docs/11). Change them here and push; a value
  // set only in the dashboard is dropped by the next deploy. Not inherited by env.production.
  "vars": { "RECOVERY_EMAILS": "log", "CHECKOUT_EXPIRES_HOURS": "2", "CHECKOUT_PROMO_CODES": "false" },
  // Previews: agents create them on the stage Worker (deploy.mjs). Bindings
  // that must not touch stage data get overridden here (docs/07: previews
  // get their own D1). env.production inherits this block unused.
  "previews": {},
  // Orders (docs/10). Schema in migrations/, applied by hand with the D1 API
  // because the stage CI token can't run migrations. Not inherited by
  // env.production: production gets its own database when the owner goes live.
  "d1_databases": [
    { "binding": "ORDERS", "database_name": "butterlu-orders-stage", "database_id": "ea59fb49-19d1-4d40-81fb-45399da9c6d8", "migrations_dir": "migrations" }
  ],
  "env": {
    "production": {
      "name": "butterlu-site",
      // No orders database in production yet: /admin stays a 404 there.
      "d1_databases": [],
      "vars": { "RECOVERY_EMAILS": "log", "CHECKOUT_EXPIRES_HOURS": "2", "CHECKOUT_PROMO_CODES": "false" }
    }
  }
}
