---
import Layout from '../../Layout.astro';
import FrameChoice from '../../components/FrameChoice.astro';
import ProductCard from '../../components/ProductCard.astro';
import { buttonVariants } from '../../components/ui/variants';
import { COLLECTIONS, type Collection, DESIGNS, collectionProducts } from '../../catalog/products';
import { collectionCopy } from '../../catalog/copy';

export function getStaticPaths() {
  const all: Collection = {
    handle: 'all',
    name: 'All frames',
    seoTitle: 'Personalized Picture Frames: Shop All',
    seoDescription: 'Every Butterlu frame: grandparents, godparents, weddings, baby and pet memorials. Personalized wording, two shapes, 44 backgrounds.',
    intro: 'Butterlu makes two frames, scalloped and rounded. Start with a blank one, or pick the design closest to your occasion and make it yours.',
  };
  return [all, ...COLLECTIONS].map((collection) => ({ params: { handle: collection.handle }, props: { collection } }));
}

interface Props {
  collection: Collection;
}
const { collection } = Astro.props;
// Designs only: the two frames sit above them, so the grid isn't look-alike products.
const products = collection.handle === 'all' ? DESIGNS : collectionProducts(collection.handle);
// Copy, FAQ and sibling links below the grid (docs/12-serp-leadership.md §5).
const copy = collectionCopy(collection.handle);
const related = (copy?.related ?? []).map((h) => COLLECTIONS.find((c) => c.handle === h)).filter((c): c is Collection => Boolean(c));
const productUrl = (handle: string) => new URL(`/products/${handle}`, Astro.site).href;
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: collection.name,
    description: collection.seoDescription,
    url: new URL(`/collections/${collection.handle}`, Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: products.length,
      itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: productUrl(p.handle), name: p.name })),
    },
  },
];
if (copy?.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  });
}
---
<Layout title={`${collection.seoTitle} | Butterlu`} description={collection.seoDescription} jsonLd={jsonLd}>
  <h1 class="text-2xl md:text-3xl">{collection.name}</h1>
  <p class="mt-2 max-w-[60ch] text-muted-foreground">{collection.intro}</p>
  <div class="mt-6"><FrameChoice /></div>
  <section aria-labelledby="designs" class="mt-10">
    <h2 id="designs" class="text-lg md:text-xl">Designs to start from</h2>
    <p class="mt-1 mb-4 text-sm text-muted-foreground">Each one opens with its wording and background filled in. Change anything, including the shape.</p>
    <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">{products.map((p, i) => <ProductCard product={p} eager={i < 2} />)}</ul>
  </section>
  {copy && (
    <div class="mt-12 grid gap-10 border-t pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
      <section class="prose" aria-label={`About ${collection.name.toLowerCase()}`}>{copy.body.map((para) => <p>{para}</p>)}</section>
      {copy.faq.length > 0 && (
        <section class="prose" aria-labelledby="faq">
          <h2 id="faq">Questions</h2>
          {copy.faq.map(([q, a]) => (<><h3>{q}</h3><p>{a}</p></>))}
        </section>
      )}
    </div>
  )}
  {related.length > 0 && (
    <nav aria-labelledby="more" class="mt-10 border-t pt-6">
      <h2 id="more" class="mb-3 text-lg">You might also like</h2>
      <ul class="flex flex-wrap gap-2">{related.map((c) => <li><a class={buttonVariants({ variant: 'outline' })} href={`/collections/${c.handle}`}>{c.name}</a></li>)}</ul>
    </nav>
  )}
</Layout>

