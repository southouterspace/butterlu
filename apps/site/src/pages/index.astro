---
import Layout from '../Layout.astro';
import FrameChoice from '../components/FrameChoice.astro';
import ProductCard from '../components/ProductCard.astro';
import { FEATURED, SHOP, productByHandle } from '../catalog/products';
import { OCCASIONS, MENU_GROUPS, groupHref, occasionHref, recipientHref } from '../catalog/taxonomy';
import { frameSvg } from '../lib/frame-svg';
import { placementsAtBuild } from '../lib/layout-build';
import Icon from '../components/ui/Icon.astro';
import { buttonVariants, cn, itemClass, itemContentClass, itemDescriptionClass, itemMediaIconClass, itemTitleClass } from '../components/ui/variants';

// The hero's value props, as shadcn Items.
const props = [
  { icon: 'heart', title: 'Made for Them', text: 'Grandma, a godmother, a new baby and more.' },
  { icon: 'pen-line', title: 'Your Design', text: 'Make every detail yours, start to finish.' },
  { icon: 'gift', title: 'Ready to Give', text: `Add a 4x6 photo. ${SHOP.shipping}.` },
] as const;
const featured = FEATURED.map((h) => productByHandle(h)!);
const hero = featured[0]!;
const heroSvg = frameSvg(hero.preset, placementsAtBuild(hero.preset), { idPrefix: 'hero', label: `${hero.name}, as designed` });
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Butterlu',
    alternateName: ['Butterlu Gifts', 'Boutique Butterlu'],
    url: Astro.site?.href,
    // Profiles that are Butterlu's, so Google ties the brand together (docs/12 §3.6).
    // Add Instagram and Facebook once the owner confirms them.
    sameAs: ['https://www.etsy.com/shop/ButterLu'],
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Butterlu', url: Astro.site?.href },
];
---
<Layout title="Personalized Picture Frames and Keepsake Gifts | Butterlu" description="Personalized picture frames for grandparents, godparents, weddings, new babies and pet memorials. Add their names and your words, and see it first." jsonLd={jsonLd} image={{ src: `/products/${hero.handle}.jpg`, width: 1200, height: 1200, alt: hero.name }}>
  <section class="grid items-center gap-6 md:grid-cols-[1fr_1.1fr] md:gap-10">
    <div class="order-2 md:order-1">
      <h1 class="text-3xl md:text-5xl">Butterlu Gifts</h1>
      <p class="mt-2 text-lg text-muted-foreground">Personalized picture frames.</p>
      <ul class="mt-5 grid gap-3" aria-label="Why Butterlu">
        {props.map((p) => (
          <li class={itemClass}>
            <span class={itemMediaIconClass}><Icon name={p.icon} /></span>
            <span class={itemContentClass}>
              <span class={itemTitleClass}>{p.title}</span>
              <span class={itemDescriptionClass}>{p.text}</span>
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-6"><a class={cn(buttonVariants({ size: 'xl' }), 'w-full sm:w-auto')} href="/collections/all">Shop All Frames</a></p>
    </div>
    <a class="order-1 block rounded-4xl bg-muted p-4 md:order-2 md:p-9" href={`/products/${hero.handle}`} set:html={heroSvg} />
  </section>

  <section aria-labelledby="for-who" class="mt-14">
    <h2 id="for-who" class="mb-4 text-xl md:text-2xl">Who is it for?</h2>
    <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3">
      {MENU_GROUPS.map((g) => (
        <li class="rounded-4xl bg-muted/60 p-4 sm:p-5">
          <a class="text-base font-medium text-foreground no-underline hover:underline" href={groupHref(g)}>{g.label}</a>
          {g.children.length > 1 && (
            <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">{g.children.map((r) => <li><a class="text-muted-foreground underline-offset-4 hover:text-foreground" href={recipientHref(r)}>{r.label}</a></li>)}</ul>
          )}
        </li>
      ))}
    </ul>
    <h3 class="mt-6 mb-3 text-base font-medium">Or by occasion</h3>
    <ul class="flex flex-wrap gap-2">
      {OCCASIONS.map((o) => <li><a class={buttonVariants({ variant: 'outline' })} href={occasionHref(o)}>{o.label}</a></li>)}
    </ul>
  </section>

  <div class="mt-14"><FrameChoice /></div>

  <section aria-labelledby="best" class="mt-14">
    <h2 id="best" class="mb-4 text-xl md:text-2xl">Most loved designs</h2>
    <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">{featured.map((p, i) => <ProductCard product={p} eager={i < 4} />)}</ul>
  </section>
</Layout>

