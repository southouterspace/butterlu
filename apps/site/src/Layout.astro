---
import { COLLECTIONS } from './catalog/products';

interface Props {
  title: string;
  description: string;
  /** Structured data objects, each emitted as its own JSON-LD script. */
  jsonLd?: object[];
  /** Keep the page out of search results (cart, checkout result). */
  noindex?: boolean;
}
const { title, description, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: '/collections/all', label: 'Shop all' },
  { href: '/collections/grandparent-frames', label: 'Grandparents' },
  { href: '/collections/new-grandparent-to-be', label: 'Announcements' },
  { href: '/collections/godparent-frames', label: 'Godparents' },
  { href: '/collections/wedding-thank-you-frames', label: 'Weddings' },
  { href: '/collections/baby-frames', label: 'Baby' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Butterlu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preload" href="/fonts/playfair-display-bold.woff" as="font" type="font/woff" crossorigin />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="logo" href="/" aria-label="Butterlu home">Butterlu</a>
        <a class="cart-link" href="/cart">Cart <span class="cart-count" data-cart-count>0</span><span class="visually-hidden"> items</span></a>
      </div>
      <nav class="wrap site-nav" aria-label="Shop">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="logo">Butterlu</p>
          <p>Personalized picture frames, made to order in two shapes and 44 backgrounds.</p>
        </div>
        <nav aria-label="Collections">
          <h2>Shop</h2>
          <ul>{COLLECTIONS.map((c) => <li><a href={`/collections/${c.handle}`}>{c.name}</a></li>)}</ul>
        </nav>
        <nav aria-label="Help">
          <h2>Help</h2>
          <ul>
            <li><a href="/pages/shipping-returns">Shipping and returns</a></li>
            <li><a href="/pages/faq">Questions</a></li>
            <li><a href="/pages/about">About Butterlu</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      import { cartCount, onCartChange } from './scripts/cart';
      const render = () => document.querySelectorAll('[data-cart-count]').forEach((el) => (el.textContent = String(cartCount())));
      render();
      onCartChange(render);
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Great Vibes'; src: url('/fonts/great-vibes.woff') format('woff'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Playfair Display'; src: url('/fonts/playfair-display-bold.woff') format('woff'); font-weight: 700; font-display: swap; }
  @font-face { font-family: 'Montserrat'; src: url('/fonts/montserrat-semibold.woff') format('woff'); font-weight: 600; font-display: swap; }

  :root {
    --bg: #fbf8f4;
    --surface: #ffffff;
    --ink: #2b2622;
    --muted: #645c54;
    --line: #e4ddd3;
    --accent: #9b3f52;
    --accent-ink: #ffffff;
    --accent-soft: #f6e9ec;
    --focus: #1f5fbf;
    --radius: 12px;
    --serif: 'Playfair Display', Georgia, serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 var(--sans); }
  img, svg { max-width: 100%; display: block; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 700; line-height: 1.2; margin: 0 0 0.5em; }
  h1 { font-size: clamp(1.7rem, 3.5vw, 2.4rem); }
  h2 { font-size: 1.35rem; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .skip { position: absolute; left: -999px; top: 8px; background: var(--surface); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .site-header { background: var(--surface); border-bottom: 1px solid var(--line); }
  .header-row { display: flex; align-items: center; justify-content: space-between; padding-top: 14px; padding-bottom: 6px; }
  .logo { font-family: var(--serif); font-size: 1.6rem; font-weight: 700; text-decoration: none; letter-spacing: 0.01em; margin: 0; }
  .cart-link { text-decoration: none; font-weight: 600; display: inline-flex; gap: 6px; align-items: center; padding: 8px 4px; }
  .cart-count { background: var(--accent); color: var(--accent-ink); border-radius: 999px; min-width: 1.5em; text-align: center; font-size: 0.8rem; padding: 0 6px; }
  .site-nav ul { list-style: none; display: flex; gap: 4px 18px; flex-wrap: wrap; padding: 0 0 10px; margin: 0; }
  .site-nav a { text-decoration: none; color: var(--muted); font-size: 0.95rem; padding: 4px 0; display: inline-block; }
  .site-nav a:hover, .site-nav a[aria-current='page'] { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }

  main { padding-top: 24px; padding-bottom: 56px; min-height: 60vh; }
  .site-footer { background: var(--surface); border-top: 1px solid var(--line); padding: 32px 0; color: var(--muted); font-size: 0.95rem; }
  .footer-grid { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .site-footer h2 { font-family: var(--sans); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); }
  .site-footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }

  .button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 999px; padding: 14px 26px; font: 600 1rem var(--sans); cursor: pointer; text-decoration: none; min-height: 48px; }
  .button:hover { filter: brightness(1.08); }
  .button[disabled] { opacity: 0.55; cursor: not-allowed; }
  .button.secondary { background: transparent; color: var(--ink); border: 1px solid var(--ink); }

  .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); padding: 0; list-style: none; margin: 0; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; height: 100%; }
  .card a { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .card .art { background: var(--accent-soft); padding: 18px; }
  .card .body { padding: 12px 16px 16px; display: grid; gap: 4px; }
  .card h3 { font-size: 1.05rem; margin: 0; }
  .card .price { color: var(--muted); }
  .card a:hover h3 { text-decoration: underline; }
  .frame-svg { width: 100%; height: auto; }
  .lede { color: var(--muted); font-size: 1.1rem; max-width: 60ch; }
  .notice { background: var(--accent-soft); border-radius: var(--radius); padding: 14px 16px; }
  .prose { max-width: 68ch; }
  .prose h2 { margin-top: 1.6em; }
</style>
