---
// A frame or design tile in the shadcn Card shape, rendered as static HTML.
import { type Product, formatPrice, frameFor, isFrame } from '../catalog/products';
import { frameSvg } from '../lib/frame-svg';
import { placementsAtBuild } from '../lib/layout-build';
import { cardClass, cn } from './ui/variants';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
  /** Load the art at once; for the first row. Later cards wait until scrolled near. */
  eager?: boolean;
}
const { product, headingLevel = 'h3', eager = false } = Astro.props;
const Heading = headingLevel;
const svg = frameSvg(product.preset, placementsAtBuild(product.preset), { idPrefix: `card-${product.handle}`, photoHint: false, size: 'card', lazy: !eager });
---
<li class={cn(cardClass, 'shadow-sm transition-shadow hover:shadow-md')}>
  <a href={`/products/${product.handle}`} class="group flex h-full flex-col text-foreground no-underline">
    <div class="bg-muted p-3 sm:p-5" set:html={svg} />
    <div class="grid gap-1 p-3 sm:p-4">
      <Heading class="text-sm leading-snug font-medium tracking-normal group-hover:underline sm:text-base">{product.name}</Heading>
      {/* A design is a starting point on one of the two frames, not a product of its own, so it shows no price. */}
      <span class="text-sm text-muted-foreground">{isFrame(product) ? `${formatPrice(product.priceCents)}, any words` : `${frameFor(product).name.replace(' picture frame', '')} frame design`}</span>
    </div>
  </a>
</li>
