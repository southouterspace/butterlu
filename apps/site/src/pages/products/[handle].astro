---
import Layout from '../../Layout.astro';
import Customizer from '../../components/Customizer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getImage } from 'astro:assets';
import { productFaq } from '../../catalog/copy';
import { productMedia } from '../../catalog/media';
import FrameChoice from '../../components/FrameChoice.astro';
import { buttonVariants } from '../../components/ui/variants';
import { occasionCount, occasionHref, recipientCount, recipientHref, tagsFor } from '../../catalog/taxonomy';
import { COLLECTIONS, CURRENCY, DESIGNS, PRODUCTS, type Product, SHOP, collectionProducts, frameFor, isFrame } from '../../catalog/products';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { handle: product.handle }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const url = new URL(`/products/${product.handle}`, Astro.site).href;
// The two frames belong to no collection; a design's first collection is its breadcrumb.
const primary = COLLECTIONS.find((c) => c.handle === product.collections[0]);
const frame = frameFor(product);
const frameUrl = new URL(`/products/${frame.handle}`, Astro.site).href;
// Images for search and link previews: real photos first (1200 px JPEG for the
// widest crawler support), then the preset drawn at build time (/products/<handle>.jpg).
const photos = await Promise.all(
  productMedia(product.handle)
    .filter((m) => m.kind === 'photo')
    .slice(0, 3)
    .map((m) => getImage({ src: m.image, width: Math.min(1200, m.image.width), format: 'jpg', quality: 80 })),
);
const rendered = { src: `/products/${product.handle}.jpg`, width: 1200, height: 1200 };
const images = [...photos.map((p) => ({ src: p.src, width: Number(p.attributes.width), height: Number(p.attributes.height) })), rendered];
const faq = productFaq(product.handle);
// Who it's for and occasions, for the "Shop more designs" links (docs/12 §4c).
const tags = tagsFor(product);
const shopMore = tags
  ? [
      { href: recipientHref(tags.for), label: `For ${tags.for.label.toLowerCase()}`, count: recipientCount(tags.for) },
      ...tags.occasions.map((o) => ({ href: occasionHref(o), label: o.label, count: occasionCount(o) })),
    ].filter((l, i, all) => l.count > 1 && all.findIndex((m) => m.href === l.href) === i)
  : [];
const related = isFrame(product)
  ? DESIGNS
  : collectionProducts(primary!.handle).filter((p) => p.handle !== product.handle).slice(0, 4);
const relatedTitle = isFrame(product) ? 'Or start from a ready-made design' : `More ${primary!.name.toLowerCase().replace(/ frames$/, '')} designs`;

// Product, Offer, shipping and returns markup: what Google's free listings and AI
// shopping agents read (docs/09-seo-shape.md §3). No review markup until native reviews exist.
const offer = {
  '@type': 'Offer',
  url,
  price: (product.priceCents / 100).toFixed(2),
  priceCurrency: CURRENCY.toUpperCase(),
  availability: 'https://schema.org/MadeToOrder',
  itemCondition: 'https://schema.org/NewCondition',
  shippingDetails: {
    '@type': 'OfferShippingDetails',
    shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
    shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
  },
  hasMerchantReturnPolicy: {
    '@type': 'MerchantReturnPolicy',
    applicableCountry: 'US',
    returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
  },
};
// Butterlu sells two products. Every product page carries its frame's full ProductGroup
// (Google's multi-page variant markup repeats the group on each variant page): it varies
// by pattern (the design), and hasVariant holds this page's Product in full plus links to
// the frame's other pages. Google then sees two products, not 26 (docs/12 §4b).
const own = {
  '@type': 'Product',
  name: isFrame(product) ? `${product.name}, your own words` : product.name,
  description: product.seoDescription,
  sku: product.handle,
  brand: { '@type': 'Brand', name: SHOP.name },
  image: images.map((i) => new URL(i.src, Astro.site).href),
  material: 'Wood and glass',
  pattern: isFrame(product) ? 'Your own words' : product.name,
  url,
  inProductGroupWithID: frame.handle,
  offers: offer,
};
const siblings = [frame, ...DESIGNS.filter((d) => d.preset.shape === frame.preset.shape)].filter((p) => p.handle !== product.handle);
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'ProductGroup',
  name: frame.name,
  description: frame.seoDescription,
  url: frameUrl,
  brand: { '@type': 'Brand', name: SHOP.name },
  productGroupID: frame.handle,
  variesBy: ['https://schema.org/pattern'],
  hasVariant: [own, ...siblings.map((d) => ({ '@type': 'Product', url: new URL(`/products/${d.handle}`, Astro.site).href }))],
};

const jsonLd = [
  productLd,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Shop', item: new URL('/collections/all', Astro.site).href },
      ...(primary
        ? [
            { '@type': 'ListItem', position: 2, name: primary.name, item: new URL(`/collections/${primary.handle}`, Astro.site).href },
            { '@type': 'ListItem', position: 3, name: product.name, item: url },
          ]
        : [{ '@type': 'ListItem', position: 2, name: product.name, item: url }]),
    ],
  },
  ...(faq.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
        },
      ]
    : []),
];
---
<Layout title={`${product.seoTitle} | Butterlu`} description={product.seoDescription} jsonLd={jsonLd} ogType="product" image={{ ...images[0]!, alt: product.name }}>
  <nav class="mb-2 text-sm text-muted-foreground md:mb-6" aria-label="Breadcrumb">
    <a class="no-underline hover:text-foreground hover:underline" href="/collections/all">Shop</a>
    {primary && (<><span aria-hidden="true">/</span> <a class="no-underline hover:text-foreground hover:underline" href={`/collections/${primary.handle}`}>{primary.name}</a></>)}
  </nav>
  <Customizer product={product} />

  <section class="mt-12 grid gap-8 border-t pt-8 md:grid-cols-2 md:gap-10">
    <div>
      <h2 class="mb-3 text-lg">A good fit for</h2>
      <ul class="grid list-disc gap-1.5 pl-5 text-muted-foreground">{product.goodFor.map((g) => <li>{g}</li>)}</ul>
    </div>
    <div>
      <h2 class="mb-3 text-lg">How it works</h2>
      <ol class="grid list-decimal gap-1.5 pl-5 text-muted-foreground">
        <li>Keep our words or make them yours: their names, a date, a line only your family would get.</li>
        <li>See exactly how it prints before you buy.</li>
        <li>We print it, build it and ship it. You add your 4x6 photo.</li>
      </ol>
    </div>
  </section>

  {faq.length > 0 && (
    <section aria-labelledby="faq" class="prose mt-12 border-t pt-8">
      <h2 id="faq">Questions</h2>
      {faq.map(([q, a]) => (<><h3>{q}</h3><p>{a}</p></>))}
    </section>
  )}

  {related.length > 0 && (
    <section aria-labelledby="related" class="mt-12">
      <h2 id="related" class="mb-4 text-lg">{relatedTitle}</h2>
      <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">{related.map((p) => <ProductCard product={p} />)}</ul>
    </section>
  )}

  {shopMore.length > 0 && (
    <nav aria-labelledby="shop-by" class="mt-10">
      <h2 id="shop-by" class="mb-3 text-lg">Shop more designs</h2>
      <ul class="flex flex-wrap gap-2">{shopMore.map((l) => <li><a class={buttonVariants({ variant: 'outline' })} href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  )}

  {!isFrame(product) && (
    <div class="mt-12"><FrameChoice /></div>
  )}
</Layout>

