---
import Layout from '../../Layout.astro';
import Customizer from '../../components/Customizer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { COLLECTIONS, CURRENCY, PRODUCTS, type Product, SHOP, collectionProducts } from '../../catalog/products';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { handle: product.handle }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const url = new URL(`/products/${product.handle}`, Astro.site).href;
const primary = COLLECTIONS.find((c) => c.handle === product.collections[0])!;
const related = collectionProducts(primary.handle).filter((p) => p.handle !== product.handle).slice(0, 4);

// Product, Offer, shipping and returns markup: what Google's free listings and AI
// shopping agents read (docs/09 §2). No review markup until native reviews exist.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: product.seoDescription,
    sku: product.handle,
    brand: { '@type': 'Brand', name: SHOP.name },
    url,
    offers: {
      '@type': 'Offer',
      url,
      price: (product.priceCents / 100).toFixed(2),
      priceCurrency: CURRENCY.toUpperCase(),
      availability: 'https://schema.org/MadeToOrder',
      itemCondition: 'https://schema.org/NewCondition',
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        applicableCountry: 'US',
        returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Shop', item: new URL('/collections/all', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: primary.name, item: new URL(`/collections/${primary.handle}`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: product.name, item: url },
    ],
  },
];
---
<Layout title={`${product.seoTitle} | Butterlu`} description={product.seoDescription} jsonLd={jsonLd}>
  <nav class="mb-2 text-sm text-muted-foreground md:mb-6" aria-label="Breadcrumb">
    <a class="no-underline hover:text-foreground hover:underline" href="/collections/all">Shop</a> <span aria-hidden="true">/</span>
    <a class="no-underline hover:text-foreground hover:underline" href={`/collections/${primary.handle}`}>{primary.name}</a>
  </nav>
  <Customizer product={product} />

  <section class="mt-12 grid gap-8 border-t pt-8 md:grid-cols-2 md:gap-10">
    <div>
      <h2 class="mb-3 text-lg">A good fit for</h2>
      <ul class="grid list-disc gap-1.5 pl-5 text-muted-foreground">{product.goodFor.map((g) => <li>{g}</li>)}</ul>
    </div>
    <div>
      <h2 class="mb-3 text-lg">How it works</h2>
      <ol class="grid list-decimal gap-1.5 pl-5 text-muted-foreground">
        <li>Pick a shape and a background. Every frame comes in all 44.</li>
        <li>Keep our words or write your own on any side.</li>
        <li>We print it, build it and ship it. You add your 4x6 photo.</li>
      </ol>
    </div>
  </section>

  {related.length > 0 && (
    <section aria-labelledby="related" class="mt-12">
      <h2 id="related" class="mb-4 text-lg">More {primary.name.toLowerCase()}</h2>
      <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">{related.map((p) => <ProductCard product={p} />)}</ul>
    </section>
  )}
</Layout>

