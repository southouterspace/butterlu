---
import Layout from '../../Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getImage } from 'astro:assets';
import { productFaq } from '../../catalog/copy';
import { productMedia } from '../../catalog/media';
import { asShownNote } from '../../catalog/example-names';
import FrameChoice from '../../components/FrameChoice.astro';
import ProductGallery from '../../components/media/ProductGallery.astro';
import Icon from '../../components/ui/Icon.astro';
import { buttonVariants, cn } from '../../components/ui/variants';
import { frameSvg } from '../../lib/frame-svg';
import { placementsAtBuild } from '../../lib/layout-build';
import { occasionCount, occasionHref, recipientCount, recipientHref, tagsFor } from '../../catalog/taxonomy';
import { COLLECTIONS, CURRENCY, DESIGNS, PRODUCTS, type Product, SHOP, collectionProducts, formatPrice, frameFor, isFrame, readyAsShown } from '../../catalog/products';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { handle: product.handle }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const url = new URL(`/products/${product.handle}`, Astro.site).href;
// The frame belongs to no collection; a design's first collection is its breadcrumb.
const primary = COLLECTIONS.find((c) => c.handle === product.collections[0]);
const frame = frameFor(product);
const frameUrl = new URL(`/products/${frame.handle}`, Astro.site).href;
// Images for search and link previews: real photos first (1200 px JPEG for the
// widest crawler support), then the preset drawn at build time (/products/<handle>.jpg).
const photos = await Promise.all(
  productMedia(product.handle)
    .filter((m) => m.kind === 'photo')
    .slice(0, 3)
    .map((m) => getImage({ src: m.image, width: Math.min(1200, m.image.width), format: 'jpg', quality: 80 })),
);
const rendered = { src: `/products/${product.handle}.jpg`, width: 1200, height: 1200 };
const images = [...photos.map((p) => ({ src: p.src, width: Number(p.attributes.width), height: Number(p.attributes.height) })), rendered];
const faq = productFaq(product.handle);
// The page sells the design as shown and hands changes to its own editor screen
// (/products/<handle>/personalize), so photos, questions and, later, reviews have room
// here. Both buttons sit side by side, Personalize first on every design: "anything can
// be personalized" (owner, 2026-11-11). The blank frame only opens the editor.
const media = productMedia(product.handle);
const preview = frameSvg(product.preset, placementsAtBuild(product.preset), { idPrefix: 'pdp', label: `${product.name}, as shown` });
const frameOnly = isFrame(product);
const quick = !frameOnly && readyAsShown(product);
const asShown = asShownNote(Object.values(product.preset.sides).flatMap((s) => (s ? [s.text] : [])));
const price = formatPrice(product.priceCents);
const personalizeHref = `/products/${product.handle}/personalize`;
// Who it's for and occasions, for the "Shop more designs" links (docs/12 §4c).
const tags = tagsFor(product);
const shopMore = tags
  ? [
      { href: recipientHref(tags.for), label: `For ${tags.for.label}`, count: recipientCount(tags.for) },
      ...tags.occasions.map((o) => ({ href: occasionHref(o), label: o.label, count: occasionCount(o) })),
    ].filter((l, i, all) => l.count > 1 && all.findIndex((m) => m.href === l.href) === i)
  : [];
const related = isFrame(product)
  ? DESIGNS
  : collectionProducts(primary!.handle).filter((p) => p.handle !== product.handle).slice(0, 4);
const relatedTitle = isFrame(product) ? 'Or start from a ready-made design' : `More ${primary!.name.toLowerCase().replace(/ frames$/, '')} designs`;

// Product, Offer, shipping and returns markup: what Google's free listings and AI
// shopping agents read (docs/09-seo-shape.md §3). No review markup until native reviews exist.
const offer = {
  '@type': 'Offer',
  url,
  price: (product.priceCents / 100).toFixed(2),
  priceCurrency: CURRENCY.toUpperCase(),
  availability: 'https://schema.org/MadeToOrder',
  itemCondition: 'https://schema.org/NewCondition',
  shippingDetails: {
    '@type': 'OfferShippingDetails',
    shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
    shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
  },
  hasMerchantReturnPolicy: {
    '@type': 'MerchantReturnPolicy',
    applicableCountry: 'US',
    returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
  },
};
// Butterlu sells one product. Every product page carries the frame's full ProductGroup
// (Google's multi-page variant markup repeats the group on each variant page): it varies
// by pattern (the design), and hasVariant holds this page's Product in full plus links to
// the frame's other pages. Google then sees one product, not 26 (docs/12 §4b).
const own = {
  '@type': 'Product',
  name: isFrame(product) ? `${product.name}, your own words` : product.name,
  description: product.seoDescription,
  sku: product.handle,
  brand: { '@type': 'Brand', name: SHOP.name },
  image: images.map((i) => new URL(i.src, Astro.site).href),
  material: 'Wood and glass',
  pattern: isFrame(product) ? 'Your own words' : product.name,
  url,
  inProductGroupWithID: frame.handle,
  offers: offer,
};
const siblings = [frame, ...DESIGNS].filter((p) => p.handle !== product.handle);
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'ProductGroup',
  name: frame.name,
  description: frame.seoDescription,
  url: frameUrl,
  brand: { '@type': 'Brand', name: SHOP.name },
  productGroupID: frame.handle,
  variesBy: ['https://schema.org/pattern'],
  hasVariant: [own, ...siblings.map((d) => ({ '@type': 'Product', url: new URL(`/products/${d.handle}`, Astro.site).href }))],
};

const jsonLd = [
  productLd,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Shop', item: new URL('/collections/all', Astro.site).href },
      ...(primary
        ? [
            { '@type': 'ListItem', position: 2, name: primary.name, item: new URL(`/collections/${primary.handle}`, Astro.site).href },
            { '@type': 'ListItem', position: 3, name: product.name, item: url },
          ]
        : [{ '@type': 'ListItem', position: 2, name: product.name, item: url }]),
    ],
  },
  ...(faq.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
        },
      ]
    : []),
];
---
<Layout title={`${product.seoTitle} | Butterlu`} description={product.seoDescription} jsonLd={jsonLd} ogType="product" image={{ ...images[0]!, alt: product.name }}>
  <nav class="mb-2 text-sm text-muted-foreground md:mb-6" aria-label="Breadcrumb">
    <a class="no-underline hover:text-foreground hover:underline" href="/collections/all">Shop</a>
    {primary && (<><span aria-hidden="true">/</span> <a class="no-underline hover:text-foreground hover:underline" href={`/collections/${primary.handle}`}>{primary.name}</a></>)}
  </nav>
  <div class="grid gap-4 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] md:items-start md:gap-10">
    <div class="pdp-preview rounded-4xl bg-muted p-3 md:sticky md:top-6 md:p-8" set:html={preview} />
    <div class="flex min-w-0 flex-col gap-5" data-shop-actions>
      <div>
        <h1 class="text-2xl md:text-3xl">{product.name}</h1>
        <p class="mt-1 text-lg font-semibold">{price}</p>
        <p class="mt-2 text-muted-foreground">{product.intro}</p>
      </div>
      <div class="grid gap-2">
        {frameOnly ? (
          <a class={cn(buttonVariants({ size: 'xl' }), 'w-full')} href={personalizeHref} data-personalize="product" data-handle={product.handle}>
            <Icon name="pen-line" />Personalize
          </a>
        ) : (
          <div class="grid grid-cols-2 gap-2">
            {(['edit', 'add'] as const).map((k, i) =>
              k === 'add' ? (
                <button
                  type="button"
                  class={cn(buttonVariants({ size: 'xl', variant: i === 0 ? 'default' : 'outline' }), 'h-auto min-h-12 py-2 whitespace-normal')}
                  data-add-as-shown={product.handle}
                  data-from="product"
                  data-spec={JSON.stringify(product.preset)}
                  aria-describedby={asShown ? 'as-shown-note' : undefined}
                >
                  {quick ? `Add to Cart · ${price}` : 'Add to Cart as Shown'}
                </button>
              ) : (
                <a
                  class={cn(buttonVariants({ size: 'xl', variant: i === 0 ? 'default' : 'outline' }), 'h-auto min-h-12 py-2 whitespace-normal')}
                  href={personalizeHref}
                  data-personalize="product"
                  data-handle={product.handle}
                >
                  <Icon name="pen-line" />Personalize
                </a>
              ),
            )}
          </div>
        )}
        {!frameOnly && asShown && <p id="as-shown-note" class="text-sm text-muted-foreground">{asShown}</p>}
        {/* Rendered from the start, so screen readers announce the update. */}
        {!frameOnly && <p class="text-sm font-medium empty:hidden" role="status" data-added-status></p>}
      </div>
      <ul class="grid gap-2 text-sm text-muted-foreground [&_svg]:shrink-0">
        <li class="flex items-center gap-2"><Icon name="clock" />{SHOP.dispatch}</li>
        <li class="flex items-center gap-2"><Icon name="truck" />{SHOP.shipping}</li>
        <li class="flex items-center gap-2"><Icon name="frame" />8.4 × 6.4 inch wood frame with glass and an easel back</li>
        <li class="flex items-center gap-2"><Icon name="heart" />{SHOP.photoNote}</li>
      </ul>
    </div>
  </div>

  {/* Lifestyle photos and video, once Asli's arrive (src/catalog/media.ts). */}
  {media.length > 0 && (
    <section aria-label="Photos" class="mt-10">
      <ProductGallery media={media} name={product.name} />
    </section>
  )}

  {/* Reviews go here once there is a source for them (Etsy's or the site's own,
      docs/04). Nothing renders until then, and no review markup goes in the JSON-LD. */}

  <section class="mt-12 border-t pt-8">
    <h2 class="mb-3 text-lg">A good fit for</h2>
    <ul class="grid list-disc gap-1.5 pl-5 text-muted-foreground">{product.goodFor.map((g) => <li>{g}</li>)}</ul>
  </section>

  {faq.length > 0 && (
    <section aria-labelledby="faq" class="prose mt-12 border-t pt-8">
      <h2 id="faq">Questions</h2>
      {faq.map(([q, a]) => (<><h3>{q}</h3><p>{a}</p></>))}
    </section>
  )}

  {related.length > 0 && (
    <section aria-labelledby="related" class="mt-12">
      <h2 id="related" class="mb-4 text-lg">{relatedTitle}</h2>
      <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">{related.map((p) => <ProductCard product={p} />)}</ul>
    </section>
  )}

  {shopMore.length > 0 && (
    <nav aria-labelledby="shop-by" class="mt-10">
      <h2 id="shop-by" class="mb-3 text-lg">Shop more designs</h2>
      <ul class="flex flex-wrap gap-2">{shopMore.map((l) => <li><a class={buttonVariants({ variant: 'outline' })} href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  )}

  {!isFrame(product) && (
    <div class="mt-12"><FrameChoice /></div>
  )}
</Layout>

<script>
  import '../../scripts/shop-actions';
</script>

<style>
  .pdp-preview :global(svg) {
    height: min(42svh, 76vw);
    width: 100%;
  }
  @media (min-width: 48rem) {
    .pdp-preview :global(svg) {
      height: auto;
    }
  }
</style>
