# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Do not paste these values into a chat session either.

# --- Etsy Open API v3 ---
# Developer Portal -> Your Apps. The v3 x-api-key header format is
# "<keystring>:<shared_secret>" — both values are required.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Numeric shop ID for ButterLu. Derivable from the shop name via the API
# if you do not have it to hand.
ETSY_SHOP_ID=
# Issued by the Webhook Portal when you create a subscription (Wave 3).
# Includes the "whsec_" prefix; strip it before base64-decoding.
ETSY_WEBHOOK_SIGNING_SECRET=

# --- Shopify Admin API ---
SHOPIFY_SHOP_DOMAIN=da0e1b-6c.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# --- Cloudflare (Wave 3) ---
# Account hosts fourfold* and rps-worker — name new workers distinctly.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
